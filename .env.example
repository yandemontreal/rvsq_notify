# RVSQ Credentials
RAMQ_NUMBER=your_ramq_number_here
SPECIAL_NUMBER=your_2_digit_special_number
FIRST_NAME=your_first_name
LAST_NAME=your_last_name
DATE_OF_BIRTH=YYYY-MM-DD
DOCTOR_NAME=Dr. Lastname
CLINIC_NAME=Clinic Name

# Appointment search (availability detection only - never books)
# POSTAL_CODE/PERIMETER_KM are only used by the "nearby clinic" flow.
POSTAL_CODE=
PERIMETER_KM=50
# Tried in order; first service with an open slot wins
SERVICE_REASONS=Suivi,Consultation semi-urgente,Consultation urgente

# Notification Settings
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=recipient_email@gmail.com

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Scheduling
# Runtime flags are CLI args: --headed, --debug, --traces (see run.sh)
# Sleep between checks is randomized in this range (minutes)
CHECK_INTERVAL_MIN_MINUTES=45
CHECK_INTERVAL_MAX_MINUTES=90
TRACE_DIR=./traces
# Persistent browser profile (keeps the Cloudflare/session cookies between runs)
BROWSER_PROFILE_DIR=./.browser_profile
